# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Use long, unique values. Do not commit real passwords.
APP_ADMIN_PASSWORD=
APP_USER_PASSWORD=

# Database
DATABASE_URL=

# Keep certificate verification enabled. Set false only for a trusted private DB with a documented CA issue.
PGSSL_REJECT_UNAUTHORIZED=true
